# Dedicated phone bridge on a deployed host. Keep actual values in a private runtime file.
ON_PHONE_ENV=deployment
OPENAI_API_KEY=
TELNYX_API_KEY=
TELNYX_APPLICATION_ID=
TELNYX_PUBLIC_KEY=
PUBLIC_BASE_URL=
CALLER_NUMBER=
TEST_PHONE=
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-6.1-sol
PLANNING_MODEL=gpt-6.1-sol
VOICE=marin
MAX_CALL_SECONDS=240
PORT=8787
CALLBACK_PORT=8788
ON_LOCAL_DATA_DIR=/var/lib/onmaul-phone
# Set this in the process/service when selecting a runtime file:
# ON_ENV_FILE=/etc/onmaul/phone.runtime.env
# PUBLIC_BASE_URL must be the deployed HTTPS domain, with /probe/, /webhooks/telnyx
# and /media/ routed to this host's 127.0.0.1:8788. Do not publish the 8787 UI.
