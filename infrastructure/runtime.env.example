# Copy to the Git-ignored local .env and fill the required application values.
# Never put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file.
OPENAI_API_KEY=
TELNYX_API_KEY=
TELNYX_APPLICATION_ID=
TELNYX_PUBLIC_KEY=
PUBLIC_BASE_URL=https://onmaul.nariacloud.com
CALLER_NUMBER=
TEST_PHONE=

# Current Fastify application. Demo mode does not place real telephone calls.
ON_EXECUTION_MODE=demo
ON_PHONE_ENABLED=no
ON_PORT=8090
ON_JOURNAL_DIR=/var/lib/onmaul/app-data/journal
ON_LOCAL_DATA_DIR=/var/lib/onmaul/app-data/phone-settings
ON_PHONE_DATA_DIR=/var/lib/onmaul/app-data/phone-history

# Required only for the application's hybrid telephone mode.
ON_OPERATOR_TOKEN=
REAL_RESIDENT_E164=
REAL_SQUAD_E164=
REAL_RESIDENT_CONSENT=no
REAL_SQUAD_CONSENT=no
