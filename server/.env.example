# 기본 demo: 키가 있어도 외부 모델/전화/119/SMS를 실행하지 않음.
# mock 서버는 .env를 자동 로드하지 않으며 shell 환경변수를 사용함.
ON_EXECUTION_MODE=demo
ON_PORT=8090
ON_JOURNAL_DIR=.data/mock

# hybrid 선택 시 필수. 저장소에 실제 값 기록 금지.
TELNYX_API_KEY=
TELNYX_APPLICATION_ID=
TELNYX_PUBLIC_KEY=
PUBLIC_BASE_URL=
CALLER_NUMBER=
ON_OPERATOR_TOKEN=

# 동의된 시연 수신자 H012/M01만. 실제 번호는 환경변수에만 저장.
REAL_RESIDENT_E164=
REAL_SQUAD_E164=
REAL_RESIDENT_CONSENT=no
REAL_SQUAD_CONSENT=no
