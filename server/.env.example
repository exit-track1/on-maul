# 기본 demo: 키가 있어도 외부 모델/전화/119/SMS를 실행하지 않음.
# 서버는 ON_ENV_FILE, .phone/.env, .env 순서로 환경 파일을 선택함.
ON_EXECUTION_MODE=demo
ON_PORT=8090
ON_JOURNAL_DIR=.data/mock

# hybrid 선택 시 필수. 저장소에 실제 값 기록 금지.
TELNYX_API_KEY=
TELNYX_APPLICATION_ID=
TELNYX_PUBLIC_KEY=
PUBLIC_BASE_URL=
CALLER_NUMBER=
ON_OPERATOR_TOKEN=

# 동의된 시연 수신자 H012/M01만. 실제 번호는 환경변수에만 저장.
REAL_RESIDENT_E164=
REAL_SQUAD_E164=
REAL_RESIDENT_CONSENT=no
REAL_SQUAD_CONSENT=no

# 기존 전화 PoC의 음성·전사를 상황실 서버에서 사용. 실제 값은 로컬 파일에만 저장.
ON_PHONE_ENABLED=no
ON_PHONE_DATA_DIR=.data/dashboard-phone
ON_LOCAL_DATA_DIR=.data
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-6.1-sol
PLANNING_MODEL=gpt-6.1-sol
VOICE=marin
MAX_CALL_SECONDS=240
REAL_GRANDMOTHER_E164=
REAL_GRANDMOTHER_CONSENT=no
# TEST_PHONE을 사용할 때는 대상 한 명과 동의를 명시.
ON_PHONE_TEST_TARGET_ID=
ON_PHONE_TEST_CONSENT=no
TEST_PHONE=
# 공개 /probe/, /webhooks/telnyx, /media/는 현재 ON_PORT로 연결해야 함.
# ON_ENV_FILE=.phone/dashboard.env npm run start:server
